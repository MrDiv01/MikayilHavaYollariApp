@using MikayilHavaYollari.Models

@{
    ViewData["Title"] = "User Forms";
    int counter = 0;
}
@model List<GetInTouch>
<div class="container mt-5">
    <h1>User Forms</h1>
    <hr />

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>User Email</th>
                    <th>User Name</th>
                    <th>Subject</th>
                    <th>Message</th>
                    <th>Receive Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (GetInTouch data in Model)
                {
                    counter++;
                    <tr>
                        <td>@counter</td>
                        <td>@data.Email</td>
                        <td>@data.UserName</td>
                        <td>@data.Subject</td>
                        <td>@data.Message</td>
                        <td>@data.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @*   <div class="alert alert-info" role="alert">
            No user forms found.
        </div> *@
</div>
