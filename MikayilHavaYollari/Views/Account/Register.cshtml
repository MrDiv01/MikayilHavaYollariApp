@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/account.css">

<div class="register-container">
    <div class="register-card">
        <div class="register-header">
            <h1><i class="bi bi-person-plus"></i> Kayit Ol</h1>
            <p>Yeni hesap olusturun</p>
        </div>

        <div class="form-info">
            <i class="bi bi-info-circle"></i> Tum alanlar zorunludur (<span class="required">*</span>)
        </div>

        <form asp-action="Register" asp-controller="Account" method="post" id="registerForm">
            <div class="form-row">
                <div class="form-group">
                    <label for="firstName">
                        Ad <span class="required">*</span>
                    </label>
                    <input type="text" id="firstName" name="firstName" class="form-control" placeholder="Adiniz" required>
                    <div class="form-error" id="firstNameError"></div>
                </div>
                <div class="form-group">
                    <label for="lastName">
                        Soyadi <span class="required">*</span>
                    </label>
                    <input type="text" id="lastName" name="lastName" class="form-control" placeholder="Soyadiniz" required>
                    <div class="form-error" id="lastNameError"></div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="email">
                        Email <span class="required">*</span>
                    </label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="your@email.com" required>
                    <div class="form-error" id="emailError"></div>
                </div>
                <div class="form-group">
                    <label for="phone">
                        Telefon <span class="required">*</span>
                    </label>
                    <input type="tel" id="phone" name="phone" class="form-control" placeholder="+994..." required>
                    <div class="form-error" id="phoneError"></div>
                </div>
            </div>

            <div class="form-row full">
                <div class="form-group">
                    <label for="phone">
                        Telefon <span class="required">*</span>
                    </label>
                    <input type="tel" id="phone" name="phone" class="form-control" placeholder="+994..." required>
                    <div class="form-error" id="phoneError"></div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="password">
                        Sifre <span class="required">*</span>
                    </label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="........" required>
                    <div class="password-strength">
                        <div class="strength-meter">
                            <div class="strength-bar" id="strengthBar"></div>
                        </div>
                        <small id="strengthText">Guclu bir sifre secin</small>
                    </div>
                    <div class="form-error" id="passwordError"></div>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">
                        Sifreyi Onayla <span class="required">*</span>
                    </label>
                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="........" required>
                    <div class="form-error" id="confirmPasswordError"></div>
                </div>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="termsAccepted" name="termsAccepted" required>
                <label class="form-check-label" for="termsAccepted">
                    Sartlari kabul ediyorum <span class="required">*</span>
                </label>
                <div class="form-error" id="termsError"></div>
            </div>

            <button type="submit" class="btn-register">
                <i class="bi bi-check-circle"></i> Kayit Ol
            </button>
        </form>

        <div class="login-link">
            Hesabiniz var mi? <a href="@Url.Action("Login", "Account")">Giris yap</a>
        </div>
    </div>
</div>

<script src="~/js/register.js"></script>
