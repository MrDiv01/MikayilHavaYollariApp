@model List<MikayilHavaYollari.Models.GetInTouch>

@{
    ViewData["Title"] = "İletişim Mesajları";
}

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-2">İletişim Mesajları</h1>
                    <p class="text-muted">Ziyaretçilerden gelen tüm iletişim isteklerini yönetin</p>
                </div>
                <span class="badge bg-primary fs-6">Toplam: @Model.Count() mesaj</span>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count() == 0)
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-inbox" style="font-size: 3rem;"></i>
            <h4 class="mt-3">Henüz mesaj yok</h4>
            <p class="text-muted">Ziyaretçilerden gelen mesajlar burada görüntülenecektir.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr class="table-light">
                        <th width="5%">ID</th>
                        <th width="20%">Ad Soyad</th>
                        <th width="25%">Email</th>
                        <th width="30%">Konu</th>
                        <th width="15%">Tarih</th>
                        <th width="5%" class="text-center">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary">@message.Id</span>
                            </td>
                            <td>
                                <strong>@message.UserName</strong>
                            </td>
                            <td>
                                <a href="mailto:@message.Email" class="text-decoration-none">
                                    <i class="fas fa-envelope"></i> @message.Email
                                </a>
                            </td>
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@message.Subject">
                                    @message.Subject
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">
                                    @message.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                </small>
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Details", "GetInTouch", new { area = "Admin", id = message.Id })" 
                                       class="btn btn-sm btn-info" title="Görüntüle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", "GetInTouch", new { area = "Admin", id = message.Id })" 
                                       class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')" title="Sil">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .table {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .table tbody tr {
        border-bottom: 1px solid #f0f0f0;
        transition: background-color 0.2s;
    }

    .table tbody tr:hover {
        background-color: #f9f9f9;
    }

    .btn-group .btn {
        padding: 0.35rem 0.6rem;
        font-size: 0.875rem;
    }

    .table-light {
        background-color: #f8f9fa;
        font-weight: 600;
        color: #495057;
    }
</style>
