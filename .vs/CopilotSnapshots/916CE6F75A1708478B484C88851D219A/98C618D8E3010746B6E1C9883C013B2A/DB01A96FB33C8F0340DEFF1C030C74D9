using Microsoft.AspNetCore.Mvc;
using MikayilHavaYollari.Data;

namespace MikayilHavaYollari.Controllers
{
    public class UserForm : Controller
    {
        private readonly ApplicationDbContext _context;

        public UserForm(ApplicationDbContext context)
        {
            _context = context;
        }

        public IActionResult Index()
        {
            var userForms = _context.UserForms.ToList();
            return View(userForms);
        }
    }
}
