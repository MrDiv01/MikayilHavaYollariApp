
@model List<MikayilHavaYollari.Models.UserForm>

@{
    ViewData["Title"] = "User Forms";
}

<div class="container mt-5">
    <h1>User Forms</h1>
    <hr />

    @if (Model != null && Model.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>User Email</th>
                        <th>User Name</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Receive Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var form in Model)
                    {
                        <tr>
                            <td>@form.Id</td>
                            <td>@form.UserEmail</td>
                            <td>@form.UserName</td>
                            <td>@form.Subject</td>
                            <td>@form.Message</td>
                            <td>@form.ReciveTime.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No user forms found.
        </div>
    }
</div>
