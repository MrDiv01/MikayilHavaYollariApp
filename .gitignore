## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options directory
.vs/
.vsl/

# Visual Studio Code
.vscode/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/
project.lock.json
project.fragment.lock.json
artifacts/

# Entity Framework
*.edmx.diagram
*.edmx

# User-specific files (Visual Studio)
*.VC.db
*.VC.VC.opendb

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# ASP.NET Core
Properties/launchSettings.json
appsettings.Development.json
secrets.json

# Database files
*.mdf
*.ldf

# Local environment files
.env
.env.local

# macOS
.DS_Store
Thumbs.db
Desktop.ini

# Node
node_modules/
package-lock.json

# Rider
.idea/
*.sln.iml

# ReSharper
.ReSharper*
.ReSharper.All.xml
